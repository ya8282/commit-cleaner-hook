{
  "description": "Strips AI attribution from commit messages and PR bodies.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "if": "Bash(git *)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "Bash", "if": "Bash(chmod *)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "Bash", "if": "Bash(rm *)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "Bash", "if": "Bash(gh *)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "Write", "if": "Write(**/.git/**)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "Edit", "if": "Edit(**/.git/**)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] },
      { "matcher": "mcp__.*__(create_pull_request|update_pull_request|create_or_update_file|delete_file|push_files|merge_pull_request|add_issue_comment|add_comment_to_pending_review|pull_request_review_write)",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/guard.py", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/check_install.py", "timeout": 10 }] }
    ]
  }
}
